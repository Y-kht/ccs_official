{
    "shared": {
        "dataset": "cifar100",
        "model": "repvgg_a2",
        "alpha": 0.05,
        "k": 50,
        "r": 0.2,
        "sampling": "augmentation",
        "batch_size": 256,
        "num_workers": 2,
        "reg_w": 0.0,
        "optimizer": "sgd",
        "grad_clip": 1.0,
        "scale": 7.0,
        "n_norms": 1,
        "use_amp": false,
        "with_replacement": false,
        "contrastive_weight": 1.0,
        "volume_weight": 0.1,
        "nce_temperature": 0.1,
        "delta": 1.0
    },
    "methods": [
        {
            "name": "Convex Hull Shrinkage",
            "type": "baseline",
            "case": "hull"
        },
        {
            "name": "HIB",
            "type": "baseline",
            "case": "hib"
        },
        {
            "name": "HIB-MoG",
            "type": "baseline",
            "case": "mog"
        },
        {
            "name": "Single (Neg)",
            "type": "metric",
            "metric": "single",
            "problem": "neg",
            "add_infonce": false,
            "lr": 0.1,
            "epochs": 150
        },
        {
            "name": "Generalized (Neg)",
            "type": "metric",
            "metric": "generalized",
            "problem": "neg",
            "add_infonce": false,
            "lr": 0.1,
            "epochs": 150
        }
    ]
}